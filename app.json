{
  "expo": {
    "name": "NutriSnap AI",
    "slug": "nutrisnap-ai",
    "version": "1.0.0",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutrisnap.ai"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nutrisnap.ai",
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00C853",
          "sounds": [
            "./assets/sounds/default_bell.wav",
            "./assets/sounds/soft_bell.wav",
            "./assets/sounds/gentle_chime.wav",
            "./assets/sounds/water_drop.wav",
            "./assets/sounds/alert_tone.wav",
            "./assets/sounds/alarm.wav",
            "./assets/sounds/heartbeat.wav",
            "./assets/sounds/gym_bell.wav",
            "./assets/sounds/classic_notification.wav",
            "./assets/sounds/digital_bell.wav"
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b0681575-9256-4f0d-9f87-71a48f68748d"
      }
    }
  }
}
